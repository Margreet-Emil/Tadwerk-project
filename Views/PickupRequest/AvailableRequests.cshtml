@model IEnumerable<RecyclingApp.Models.PickupRequest>
@{
    ViewData["Title"] = "My New Tasks";
}

<h2 class="text-primary-green mb-4"><i class="bi bi-bell me-2" aria-hidden="true"></i>New Tasks Assigned To You</h2>

@if (!Model.Any())
{
    <div class="alert alert-light border text-center p-5">
        <i class="bi bi-check-circle fs-1 text-success mb-3 d-block"></i>
        <h4>You're all caught up!</h4>
        <p class="text-muted">No new tasks assigned to you by the admin right now. Check back later.</p>
    </div>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h5 class="card-title mb-0"><i class="bi bi-person-circle me-2"></i>@(item.User?.Name ?? "USER")</h5>
                            <span class="badge bg-info text-dark">Approved by Admin</span>
                        </div>
                        
                        <p class="mb-2"><i class="bi bi-calendar-event me-2 text-muted"></i><strong>Scheduled:</strong> @item.ScheduledAt.ToString("MMM dd, yyyy")</p>
                        <p class="mb-2"><i class="bi bi-geo-alt me-2 text-muted"></i><strong>Address:</strong> @(item.User?.Address ?? "N/A")</p>
                        
                        <hr />
                        
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <p class="mb-0 text-muted small">Items: @(item.RequestItems?.Count() ?? 0)</p>
                                <p class="mb-0 fw-bold text-primary-green fs-5">@item.TotalValue.ToString("N2") EGP</p>
                            </div>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary">View</a>
                                <form asp-action="AcceptRequest" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-primary-green">Accept Task</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
