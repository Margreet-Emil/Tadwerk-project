@model RecyclingApp.ViewModels.CreatePickupRequestViewModel
@{
    ViewData["Title"] = "New Pickup Request";
}

<style>.tw-policy{background:#f1f8f1;border:1px solid #cfe5cf;border-left:5px solid #2E7D32;border-radius:14px;padding:1.25rem 1.5rem}.tw-policy ul{padding-left:1.1rem;color:#33443a}.tw-policy li{margin-bottom:.4rem}</style>
<h2 class="text-primary-green mb-4"><i class="bi bi-plus-circle me-2" aria-hidden="true"></i>New Pickup Request</h2>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="ScheduledAt" class="form-label fw-bold">Select Date for Pickup</label>
                <input asp-for="ScheduledAt" class="form-control" type="date" min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" required />
                <span asp-validation-for="ScheduledAt" class="text-danger"></span>
            </div>

            <h5 class="mb-3 fw-bold">Waste Items</h5>
            <div class="table-responsive mb-4">
                <table class="table table-bordered align-middle" id="itemsTable">
                    <thead class="table-light">
                        <tr>
                            <th width="50px">Select</th>
                            <th>Waste Type</th>
                            <th>Price/kg (EGP)</th>
                            <th width="200px">Estimated Quantity (kg)</th>
                            <th>Estimated Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <tr>
                                <td class="text-center">
                                    <input type="hidden" asp-for="@Model.Items[i].WasteTypeId" />
                                    <input type="hidden" asp-for="@Model.Items[i].WasteTypeName" />
                                    <input type="hidden" asp-for="@Model.Items[i].PricePerKg" class="price-val" />
                                    <input type="checkbox" asp-for="@Model.Items[i].IsSelected" class="form-check-input item-select" />
                                </td>
                                <td>@Model.Items[i].WasteTypeName</td>
                                <td>@Model.Items[i].PricePerKg.ToString("N2")</td>
                                <td>
                                    <input asp-for="@Model.Items[i].QuantityKg" type="number" step="0.1" min="0.1" class="form-control item-qty" disabled />
                                </td>
                                <td class="item-subtotal">0.00 EGP</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light fw-bold">
                            <td colspan="4" class="text-end">Estimated Total:</td>
                            <td id="estimatedTotal">0.00 EGP</td>
                        </tr>
                    </tfoot>
                </table>
            </div>

            <div class="tw-policy mb-4" role="group" aria-labelledby="policyTitle">
                <h5 id="policyTitle" class="fw-bold mb-3"><i class="bi bi-shield-check me-2" aria-hidden="true"></i>Accuracy &amp; Privacy Policy</h5>
                <ul class="mb-3">
                    <li><strong>Be accurate.</strong> The waste types and quantities you entered must match what is ready for pickup.</li>
                    <li><strong>The collector checks on arrival.</strong> If the waste is a different type, far less than stated, or not available, the collector can report it.</li>
                    <li><strong>Service fee.</strong> A reported mismatch fails the request and a fee of <strong>@(((decimal)(ViewBag.Fee ?? 50m)).ToString("0.##")) EGP</strong> is recorded on it to cover the wasted trip.</li>
                    <li><strong>Your privacy.</strong> Your name, phone and address are shared only with the admin and the collector assigned to this pickup, and only to complete it.</li>
                </ul>
                <div class="form-check">
                    <input asp-for="AcceptPolicy" class="form-check-input" id="acceptPolicy" />
                    <label asp-for="AcceptPolicy" class="form-check-label fw-semibold" for="acceptPolicy">I have read and agree to the Accuracy &amp; Privacy Policy.</label>
                </div>
                <span asp-validation-for="AcceptPolicy" class="text-danger"></span>
            </div>

            <button type="submit" id="submitBtn" class="btn btn-primary-green px-5 py-2 fw-bold" disabled>Submit Request</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2 py-2">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const rows = document.querySelectorAll('#itemsTable tbody tr');
            
            function calculateTotals() {
                let total = 0;
                rows.forEach(row => {
                    const cb = row.querySelector('.item-select');
                    const qtyInput = row.querySelector('.item-qty');
                    const price = parseFloat(row.querySelector('.price-val').value) || 0;
                    const subtotalCell = row.querySelector('.item-subtotal');
                    
                    if (cb.checked) {
                        qtyInput.disabled = false;
                        if (!qtyInput.value) qtyInput.value = '1';
                        const qty = parseFloat(qtyInput.value) || 0;
                        const sub = qty * price;
                        subtotalCell.textContent = sub.toFixed(2) + ' EGP';
                        total += sub;
                    } else {
                        qtyInput.disabled = true;
                        qtyInput.value = '0';
                        subtotalCell.textContent = '0.00 EGP';
                    }
                });
                document.getElementById('estimatedTotal').textContent = total.toFixed(2) + ' EGP';
            }

            rows.forEach(row => {
                const cb = row.querySelector('.item-select');
                const qtyInput = row.querySelector('.item-qty');
                
                cb.addEventListener('change', calculateTotals);
                qtyInput.addEventListener('input', calculateTotals);
            });
            
            calculateTotals();

            const accept = document.getElementById('acceptPolicy');
            const btn = document.getElementById('submitBtn');
            function syncBtn() { btn.disabled = !accept.checked; }
            accept.addEventListener('change', syncBtn);
            syncBtn();
        });
    </script>
}
