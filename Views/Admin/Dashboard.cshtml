@model RecyclingApp.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="text-primary-green mb-4"><i class="bi bi-speedometer2 me-2" aria-hidden="true"></i>Admin Dashboard</h2>

<div class="row mb-4">
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 border-start border-4 border-primary h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="small fw-bold text-primary text-uppercase mb-1">Total Requests</div>
                        <div class="h5 mb-0 fw-bold text-dark"><span data-n="@Model.TotalRequests" data-dec="0">@Model.TotalRequests</span></div>
                    </div>
                    <div class="col-auto">
                        <i aria-hidden="true" class="bi bi-clipboard-check fs-2 text-muted"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 border-start border-4 border-warning h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="small fw-bold text-warning-emphasis text-uppercase mb-1">Pending Requests</div>
                        <div class="h5 mb-0 fw-bold text-dark"><span data-n="@Model.PendingRequests" data-dec="0">@Model.PendingRequests</span></div>
                    </div>
                    <div class="col-auto">
                        <i aria-hidden="true" class="bi bi-hourglass fs-2 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 border-start border-4 border-success h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="small fw-bold text-success text-uppercase mb-1">Completed Weight (kg)</div>
                        <div class="h5 mb-0 fw-bold text-dark">@Model.CompletedWeightKg.ToString("N1")</div>
                    </div>
                    <div class="col-auto">
                        <i aria-hidden="true" class="bi bi-box fs-2 text-muted"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 border-start border-4 border-info h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="small fw-bold text-info-emphasis text-uppercase mb-1">Completed Value (EGP)</div>
                        <div class="h5 mb-0 fw-bold text-dark">@Model.CompletedValue.ToString("N2")</div>
                    </div>
                    <div class="col-auto">
                        <i aria-hidden="true" class="bi bi-currency-dollar fs-2 text-muted"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title text-muted mb-0">Registered Customers</h5>
                    <h3 class="mb-0 mt-2">@Model.UserCount</h3>
                </div>
                <i aria-hidden="true" class="bi bi-people display-4 text-primary-green opacity-50"></i>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card shadow-sm">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="card-title text-muted mb-0">Active Collectors</h5>
                    <h3 class="mb-0 mt-2">@Model.CollectorCount</h3>
                </div>
                <i aria-hidden="true" class="bi bi-truck display-4 text-primary-green opacity-50"></i>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="m-0 fw-bold text-primary-green">Recent Requests</h5>
        <a asp-action="AllRequests" class="btn btn-sm btn-outline-primary-green">View All</a>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Value</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentRequests != null && Model.RecentRequests.Any())
                    {
                        foreach (var req in Model.RecentRequests)
                        {
                            <tr>
                                <td>#@req.Id</td>
                                <td>@req.User?.Name</td>
                                <td>@req.CreatedAt.ToString("MMM dd, yyyy")</td>
                                <td>
                                    @if(req.Status == "Pending") { <span class="badge bg-warning text-dark">Pending</span> }
                                    else if(req.Status == "Completed") { <span class="badge bg-success">Completed</span> }
                                    else if(req.Status == "Rejected") { <span class="badge bg-danger">Rejected</span> }
                                    else if(req.Status == "Failed") { <span class="badge bg-dark">Failed</span> }
                                    else { <span class="badge bg-info text-dark">@req.Status</span> }
                                </td>
                                <td>@req.TotalValue.ToString("N2") EGP</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">No recent requests</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header bg-white py-3">
        <h5 class="m-0 fw-bold text-primary-green">Order Statistics</h5>
        <div class="small text-muted">Count and value of requests by status. Only Completed counts toward the headline value.</div>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Status</th><th>Orders</th><th>Value (EGP)</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="badge bg-success">Completed</span></td>
                        <td>@Model.CompletedRequests</td>
                        <td class="fw-bold text-success">@Model.CompletedValue.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-info text-dark">In progress</span> <span class="small text-muted">(Approved / Accepted / Collected)</span></td>
                        <td>@Model.InProgressRequests</td>
                        <td class="fw-bold">@Model.InProgressValue.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-warning text-dark">Pending</span></td>
                        <td>@Model.PendingRequests</td>
                        <td class="fw-bold text-warning-emphasis">@Model.PendingValue.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-danger">Rejected</span></td>
                        <td>@Model.RejectedRequests</td>
                        <td class="fw-bold text-danger">@Model.RejectedValue.ToString("N2")</td>
                    </tr>
                    <tr>
                        <td><span class="badge bg-dark">Failed</span></td>
                        <td>@Model.FailedRequests</td>
                        <td class="fw-bold">@Model.FailedValue.ToString("N2")</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
