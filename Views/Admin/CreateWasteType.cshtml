@model RecyclingApp.Models.WasteType
@{
    ViewData["Title"] = "Add Waste Type";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm mt-4">
            <div class="card-body p-4">
                <h3 class="card-title text-primary-green mb-4">Add New Waste Type</h3>
                <form asp-action="CreateWasteType" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-bold">Waste Type Name</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Cardboard" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PricePerKg" class="form-label fw-bold">Price Per kg (EGP)</label>
                        <div class="input-group">
                            <input asp-for="PricePerKg" class="form-control" type="number" step="0.01" min="0" />
                            <span class="input-group-text">EGP</span>
                        </div>
                        <span asp-validation-for="PricePerKg" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary-green px-4">Create</button>
                        <a asp-action="ManageWasteTypes" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
