@model IEnumerable<RecyclingApp.Models.WasteType>
@{
    ViewData["Title"] = "Manage Waste Types";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="text-primary-green"><i class="bi bi-recycle me-2" aria-hidden="true"></i>Manage Waste Types</h2>
    <a asp-action="CreateWasteType" class="btn btn-primary-green"><i class="bi bi-plus-lg"></i> Add Waste Type</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Price per kg (EGP)</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td class="fw-bold">@item.Name</td>
                            <td>@item.PricePerKg.ToString("N2")</td>
                            <td>
                                <a asp-action="EditWasteType" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
